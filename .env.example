# AI Orchestrator Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# Note: Real secrets/keys should NEVER be committed to version control.

# Application Environment
# Options: development | test | production
NODE_ENV=development

# Server Host & Port
PORT=3000
HOST=127.0.0.1

# SQLite Database Path (Required)
# Relative or absolute file path, or :memory: for temporary testing
DATABASE_PATH=./data/orchestrator.db

# Log Level
# Options: debug | info | warn | error
LOG_LEVEL=info

# AGY CLI Worker Command & Arguments
AGY_BIN=agy
AGY_ARGS=-p

# Dashboard API Target URL
NEXT_PUBLIC_ORCH_URL=http://127.0.0.1:3000
